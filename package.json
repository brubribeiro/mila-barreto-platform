{
  "name": "mila-barreto-platform",
  "private": true,
  "version": "0.2.1",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run start:dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run start:dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
